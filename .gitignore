# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
# Claude Code session state + worktrees — never commit
.claude/

# Data / artifacts (never commit downloaded tiles or datacubes)
data/
# QGIS scratch: downloaded tiles, RGB/composite exports (manual-test outputs)
tests/outputs/
*.npy
*.parquet
*.geojson
*.jp2
*.tif
*.tiff

# Tutorial micro-fixture (spec 42 D6) — deliberately committed; see
# tests/data/tutorial/NOTICE. Un-excludes the directory tree itself first
# (a parent-directory exclusion above, "data/", can't be re-included by a
# file-level negation alone), then the whole subtree.
!tests/data/
!tests/data/tutorial/
!tests/data/tutorial/**
tests/data/tutorial/__pycache__/

# Secrets
*credentials*.json
.env
secrets/
mysecrets.py

# macOS
.DS_Store

# Snakemake working dir (from local runner / dry-runs)
.snakemake/

# mini-MPC harness (spec 30) — Docker Postgres data dir + generated load artifacts
demos/mini_mpc/.pgdata/
*.ndjson
_result_register.json

# tagged A/B intermediates (spec 13) — regenerable; deliverable is cog_vs_jp2_*
benchmarks/datacube_throughput_report_*.md
benchmarks/datacube_throughput_figures_*/

# P4 (spec 41 D7): the filled-in copy of env.example.sh -- real account names, ids, URLs
env.local.sh

# Working notebooks: none are tracked, and they hold live cloud identifiers in
# both source and outputs. Ignore the whole class, not one file at a time.
notebooks/*.ipynb
notebooks/demo_*

# The AML image build contexts (docs/howto/build-the-images.md) ARE tracked -- a
# Dockerfile and an environment.yml carry no cloud identifiers, and keeping them in
# the repo is what stops them drifting from the how-to that documents them. The fsd
# wheel dropped into them at build time is a binary artifact and is not.
notebooks/images/*/fsd-*.whl
notebooks/images/.wheel/
notebooks/images/*/.last_registered.json
